{block content}

<section class="content">
  <div class="clearfix">
    <h1 n:block="title">Tabuľky — {$archive->label}</h1>
  </div>
</section>

{if $tables->count()}
  <div n:foreach="$tables as $table" class="table-responsive">
    <table class="table standings-table">
      <caption>
        <h2 class="text-center">{$table['group']->label} — {$table['type']->label}</h2>
      </caption>
      <thead>
        <tr>
          <th>P.č.</th>
          <th>Tím</th>
          <th class="standings-stat" title="Výhry">V</th>
          <th class="standings-stat" title="Výhry po predĺžení">VP</th>
          <th class="standings-stat" title="Remízy">R</th>
          <th class="standings-stat" title="Prehry po predĺžení">PP</th>
          <th class="standings-stat" title="Prehry">P</th>
          <th>Skóre</th>
          <th>Rozdiel</th>
          <th>Body</th>
        </tr>
      </thead>
      <tbody>
        <tr n:foreach="$table['entries'] as $entry" {if $iterator->first}class="first"{/if}>
          {var $team = $entry->ref('teams', 'team_id')}
          <td>{$iterator->counter}.</td>
          <td>
            {if $team->logo and file_exists($imageFolder . '/' . $team->logo)}
              <img src="{$basePath}/{$imageFolder}/{$team->logo}" width="30px" alt="{$team->name}" />
            {/if}
            {$team->name}
          </td>
          <td class="standings-stat">{$entry->win}</td>
          <td class="standings-stat standings-overtime">{$entry->overtime_win}</td>
          <td class="standings-stat">{$entry->tram}</td>
          <td class="standings-stat standings-overtime">{$entry->overtime_loss}</td>
          <td class="standings-stat">{$entry->lost}</td>
          <td>{$entry->score1}:{$entry->score2}</td>
          <td>{$entry->score1 - $entry->score2}</td>
          <td class="standings-points"><strong>{$entry->points}</strong></td>
        </tr>
      </tbody>
    </table>
  </div>
{else}
  <p>V tejto sezóne nie sú evidované žiadne tabuľky.</p>
{/if}

{/block}
