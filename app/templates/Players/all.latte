{block content}

<section class="content">
  <div class="clearfix">
    {block title}
      <h1>Štatistiky</h1>
      <h2>{$group->label}</h2>
    {/block}
  </div>
  <p n:if="$user->loggedIn" class="text-muted">
    Z = počet evidovaných účastí vo všetkých zápasoch. ZČ a 25 % sa počítajú iba zo zápasov v tabuľke „Základná časť“.
    Stav „Neúplná“ znamená, že pri niektorom zápase základnej časti ešte nie je uložená dochádzka.
  </p>
</section>

<div id="players-wrapper" n:if="$players->getRowCount()" class="table-responsive">
  <table id="players" class="table" style="width: 100%">
    <thead>
      <tr>
        <th>P.č.</th>
        <th>Meno a priezvisko</th>
        <th>Číslo</th>
        <th>Tím</th>
        <th>Góly</th>
        <th>Asistencie</th>
        <th>Kanadské bodovanie</th>
        <th title="Počet zápasov podľa evidovanej dochádzky">Z</th>
        <th n:if="$user->loggedIn" title="Odohrané zápasy hráča / zápasy tímu v základnej časti">ZČ</th>
        <th n:if="$user->loggedIn" title="Percento zápasov základnej časti">% ZČ</th>
        <th n:if="$user->loggedIn" title="Splnená podmienka aspoň 25 % zápasov základnej časti">25 %</th>
      </tr>
    </thead>
    <tbody>
      {var $previousPoints = -1}
      <tr n:foreach="$players as $player" class="{if $i == 0}first{/if}">
        {var $currentPoints = $player->goals + $player->assistances}
        <td>{if $currentPoints == $previousPoints}{$i}.{else}{$i = $j + 1}.{/if}</td>
        <td>
          <a n:href="view $player->id, $player->team_id">{$player->name}</a></td>
        <td>{$player->number}</td>
        <td>
          {*<a n:href="Teams:view $player->team_id">*}
            {if $player->team_logo and file_exists($imageFolder . '/' . $player->team_logo)}
            <img src="{$basePath}/{$imageFolder}/{$player->team_logo}" width="30px" />
              {$player->team_name}
            {/if}
          {*</a>*}
        </td>
        <td>{$player->goals}</td>
        <td>{$player->assistances}</td>
        <td class="text-danger">{$currentPoints}</td>
        <td>{$player->games_played}</td>
        <td n:if="$user->loggedIn">{$player->regular_season_games_played} / {$player->regular_season_games}</td>
        <td n:if="$user->loggedIn">{$player->regular_season_attendance_percent} %</td>
        <td n:if="$user->loggedIn">
          {if $player->regular_season_games == 0}
            —
          {elseif !$player->attendance_complete}
            <span class="label label-warning" title="Dochádzka je uložená iba pri {$player->recorded_regular_season_games} z {$player->regular_season_games} zápasov základnej časti.">Neúplná</span>
          {elseif $player->has_25_percent}
            <span class="label label-success">Áno</span>
          {else}
            <span class="label label-danger">Nie</span>
          {/if}
        </td>
        {var $j = $j + 1}
        {var $previousPoints = $player->goals + $player->assistances}
      </tr>
    </tbody>
    <tfoot>
      <tr>
        <th>P.č.</th>
        <th>Meno a priezvisko</th>
        <th>Číslo</th>
        <th>Tím</th>
        <th>Góly</th>
        <th>Asistencie</th>
        <th>Kanadské bodovanie</th>
        <th>Z</th>
        <th n:if="$user->loggedIn">ZČ</th>
        <th n:if="$user->loggedIn">% ZČ</th>
        <th n:if="$user->loggedIn">25 %</th>
      </tr>
    </tfoot>
  </table>
</div>

{/block}

{block styles}
  {include parent}
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap.min.css" type="text/css">
{/block}

{block scripts}
  {include parent}
  <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js" type="text/javascript"></script>
  <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap.min.js" type="text/javascript"></script>
  <script type="text/javascript">
    $(function () {
      const $table = $('#players');

      if ($table.length) {
        $table.DataTable();
      }
    });
  </script>
{/block}